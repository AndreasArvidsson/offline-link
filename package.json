{
    "name": "offline-link",
    "displayName": "OfflineLink",
    "productName": "OfflineLink",
    "description": "An unofficial, offline tournament notebook for Magic organizers",
    "version": "0.2.0",
    "author": "AndreasArvidsson",
    "license": "MIT",
    "main": "out/main.js",
    "private": true,
    "scripts": {
        "clean": "rm -rf out dist",
        "postinstall": "install-electron",
        "start": "electron-vite dev",
        "build": "electron-vite build",
        "package": "npm run clean && npm run build && tsx ./scripts/package.mts",
        "typecheck": "tsc -p . && tsc -p src/renderer",
        "lint:ts": "oxlint -c oxlint.config.mts --deny-warnings .",
        "lint:style": "stylelint --ignore-path .gitignore **/*.css",
        "lint:fmt": "oxfmt --check .",
        "lint": "npm run typecheck && npm run lint:ts && npm run lint:style && npm run lint:fmt",
        "fix:ts": "oxlint -c oxlint.config.mts --fix .",
        "fix:style": "stylelint --ignore-path .gitignore --fix **/*.css",
        "fix:fmt": "oxfmt .",
        "fix": "npm run fix:ts && npm run fix:style && npm run fix:fmt",
        "test": "tsx ./src/tests/runAllTests.ts"
    },
    "engines": {
        "node": ">=v24.14.0"
    },
    "dependencies": {
        "bootstrap": "^5.3.8",
        "preact": "^11.0.1",
        "react-bootstrap-icons": "^1.11.6"
    },
    "devDependencies": {
        "@electron/packager": "^20.3.0",
        "@preact/preset-vite": "^2.10.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.19.1",
        "electron-vite": "^5.0.0",
        "electron": "^44.7.0",
        "mocha": "^12.0.3",
        "oxfmt": "^0.72.0",
        "oxlint-tsgolint": "^7.0.2003",
        "oxlint": "^1.87.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint": "^17.12.0",
        "tsx": "4.23.15",
        "typescript": "^7.0.2",
        "vite-plugin-purgecss": "^0.2.13"
    }
}
